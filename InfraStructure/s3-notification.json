{
    "LambdaFunctionConfigurations": [
        {
            "Id": "SupplierIngestionTrigger",
            "LambdaFunctionArn": "PASTE-YOUR-LAMBDA-ARN-HERE",
            "Events": [
                "s3:ObjectCreated:*"
            ],
            "Filter": {
                "Key": {
                    "FilterRules": [
                        {
                            "Name": "prefix",
                            "Value": "incoming/"
                        }
                    ]
                }
            }
        }
    ]
}